# Database Configuration
# Copy this file to .env and update with your values

# Database Type (sqlite, postgresql, or mysql)
DB_TYPE=sqlite

# Database Name or Path (for SQLite)
# For SQLite, this can be a file path or ":memory:" for in-memory database
DB_DATABASE=app.db

# Database Host (for PostgreSQL/MySQL only)
# DB_HOST=localhost

# Database Port (for PostgreSQL/MySQL only)
# Leave empty to use defaults: PostgreSQL=5432, MySQL=3306
# DB_PORT=5432

# Database Username (for PostgreSQL/MySQL only)
# DB_USERNAME=myuser

# Database Password (for PostgreSQL/MySQL only)
# DB_PASSWORD=mypassword

# SQL Query Logging (true/false)
# Set to true to see SQL queries in logs (useful for debugging)
DB_ECHO=false

# Connection Pool Size (for PostgreSQL/MySQL only)
# Number of connections to maintain in the pool
DB_POOL_SIZE=5

# Max Overflow Connections (for PostgreSQL/MySQL only)
# Maximum number of connections that can be created beyond pool_size
DB_MAX_OVERFLOW=10

# Example PostgreSQL Configuration (uncomment to use):
# DB_TYPE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_DATABASE=myapp
# DB_USERNAME=postgres
# DB_PASSWORD=secretpassword
# DB_ECHO=false
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# Example MySQL Configuration (uncomment to use):
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=myapp
# DB_USERNAME=root
# DB_PASSWORD=secretpassword
# DB_ECHO=false
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
